# ===================================================
# Smart Document Assistant - Environment Configuration
# ===================================================

# Groq API Key (Required for live generative answers and summaries)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_actual_secret_key_here

# LLM Model Name (Default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Pretrained sentence transformer model for dense embeddings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Document Chunking Configuration (characters)
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Retrieval Configuration
TOP_K=4

# Minimum cosine similarity threshold for considering a chunk relevant (0.0 to 1.0)
RELEVANCE_THRESHOLD=0.35
